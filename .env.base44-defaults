# Non-secret development placeholders for the Base44 sandbox.
#
# Loaded BEFORE /run/base44/app.env (see docker-compose.base44.yml), so any value
# provided through the Base44 dashboard always overrides what is in here.
# Never put production credentials in this file.

# Boot fallback only: the real session signing key is delivered as a Base44
# secret (see .base44/environment.json). This value just keeps the stack
# bootable if the managed env file is unavailable.
SESSION_SECRET=bit2block-sandbox-session-secret-placeholder
