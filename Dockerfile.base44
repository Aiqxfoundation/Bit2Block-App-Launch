# Base44 sandbox image for the BIT2BLOCK pnpm workspace.
#
# This image only provides the runtime tooling (Node + pnpm). Application
# dependencies are installed at container startup from the bind-mounted
# checkout, and the app itself runs from the mounted source with live reload,
# so edits made in the sandbox are reflected without rebuilding.
FROM node:22

# pnpm is the workspace package manager (pnpm-lock.yaml, lockfileVersion 9.0).
RUN npm install -g pnpm@10

WORKDIR /app
